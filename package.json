{
  "name": "revisecode-workspace",
  "version": "1.0.0",
  "description": "ReviseCode Workspace",
  "scripts": {
    "start": "node frontend/local-server.cjs 3000",
    "start:backend": "node backend/src/server.js",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "node --test frontend/tests/*.test.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "serve": "python3 -m http.server 3000 --directory frontend"
  }
}
