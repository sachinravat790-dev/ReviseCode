# ReviseCode Backend Environment Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Configuration
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# IMPORTANT: Use the service_role key for backend operations.
# NEVER expose this key to frontend code or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# =====================================================================
# Official WhatsApp Business Platform Cloud API Configuration
# =====================================================================
# Test Mode:
# When WHATSAPP_TEST_MODE is set to 'true' (or omitted), messages are safely
# simulated in memory and logged to whatsapp_logs without calling the Meta API.
# Set WHATSAPP_TEST_MODE=false only after completing Meta recipient verification.
WHATSAPP_TEST_MODE=true

# Meta Developer App -> WhatsApp -> API Setup:
# Temporary or permanent system user access token with whatsapp_business_messaging permissions
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_access_token_here

# Meta Developer App -> WhatsApp -> API Setup -> Phone number ID
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Meta Developer App -> WhatsApp -> API Setup -> WhatsApp Business Account ID (optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Recipient phone number with country code (no spaces, dashes, or +, e.g. 919876543210)
# NOTE: In Meta Development Mode, this recipient number MUST be verified under
# "To" in Meta Developer Dashboard -> WhatsApp -> API Setup before messages will deliver.
WHATSAPP_RECIPIENT_PHONE_NUMBER=919876543210

# Cloud API Version (defaults to v21.0)
WHATSAPP_API_VERSION=v21.0

# Optional: Meta Approved Template configuration (leave blank for standard text messages)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# =====================================================================
# Google Gemini API Configuration (Optional)
# =====================================================================
# When configured, enables full natural language reasoning and coding assistance
# in the ReviseCode AI Companion. When omitted, the assistant operates in Grounded
# Workspace Mode directly over your live Supabase database records.
GEMINI_API_KEY=
